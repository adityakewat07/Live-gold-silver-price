<script>
const OUNCE = 31.1035;

function rupee(n) {
  return "₹" + n.toLocaleString("en-IN", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  });
}

async function getLivePrice(symbol) {
  const url = `https://api.gold-api.com/price/${symbol}/INR`;

  const response = await fetch(url, {
    cache: "no-store"
  });

  if (!response.ok) {
    throw new Error("API Error: " + response.status);
  }

  const data = await response.json();

  if (data.currency !== "INR" ||
      !Number.isFinite(Number(data.price))) {
    throw new Error("Invalid API data");
  }

  return {
    gram: Number(data.price) / OUNCE,
    updatedAt: data.updatedAt
  };
}

async function updateLiveRates() {
  const status = document.getElementById("status");

  try {
    status.textContent = "LIVE भाव अपडेट हो रहे हैं...";

    const [gold, silver] = await Promise.all([
      getLivePrice("XAU"),
      getLivePrice("XAG")
    ]);

    const g24 = gold.gram;
    const g22 = g24 * 22 / 24;
    const g18 = g24 * 18 / 24;
    const s = silver.gram;

    document.getElementById("g24").textContent = rupee(g24);
    document.getElementById("g24ten").textContent =
      "10 ग्राम: " + rupee(g24 * 10);

    document.getElementById("g22").textContent = rupee(g22);
    document.getElementById("g22ten").textContent =
      "10 ग्राम: " + rupee(g22 * 10);

    document.getElementById("g18").textContent = rupee(g18);
    document.getElementById("g18ten").textContent =
      "10 ग्राम: " + rupee(g18 * 10);

    document.getElementById("silver").textContent = rupee(s);
    document.getElementById("silverten").textContent =
      "10 ग्राम: " + rupee(s * 10);

    const time = new Date(gold.updatedAt);

    status.textContent =
      "🟢 LIVE SPOT RATE | API अपडेट: " +
      time.toLocaleString("en-IN", {
        timeZone: "Asia/Kolkata"
      }) + " IST";

  } catch (error) {
    status.textContent =
      "🔴 LIVE DATA नहीं मिला: " + error.message;
  }
}

updateLiveRates();
setInterval(updateLiveRates, 30000);
</script>
