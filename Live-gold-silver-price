<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Live Gold Silver Price</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f2f4f8;font-family:Arial,sans-serif;color:#222}
header{background:linear-gradient(120deg,#8b5700,#f5a623);color:white;text-align:center;padding:24px 12px}
header h1{margin:0;font-size:25px}
.container{max-width:850px;margin:auto;padding:14px}
.status,.card,.box{background:white;border-radius:13px;padding:15px;margin-bottom:13px;box-shadow:0 2px 9px #0000000d}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.card h3{margin:0 0 12px;color:#8b5700}
.price{font-size:22px;font-weight:bold;color:#14834a}
.small{font-size:12px;color:#777;margin-top:8px}
h2{font-size:19px}
select,input{width:100%;padding:12px;border:1px solid #ddd;border-radius:8px;margin:7px 0}
button{background:#e99513;color:white;border:0;padding:12px;border-radius:8px;width:100%;font-size:15px}
canvas{width:100%;height:180px}
.note{font-size:12px;color:#777;line-height:1.5}
footer{text-align:center;padding:20px;color:#777}
@media(max-width:450px){.price{font-size:18px}}
</style>
</head>
<body>

<header>
<h1>🥇 GOLD & SILVER TRACKER</h1>
<p>भारत में सोना और चांदी का लाइव भाव</p>
</header>

<div class="container">

<div class="status" id="status">भाव लोड हो रहे हैं...</div>

<div class="grid">
<div class="card">
<h3>🥇 24 कैरेट सोना</h3>
<div class="price" id="g24">लोड हो रहा है</div>
<div class="small" id="g24ten">10 ग्राम: --</div>
</div>

<div class="card">
<h3>🥇 22 कैरेट सोना</h3>
<div class="price" id="g22">लोड हो रहा है</div>
<div class="small" id="g22ten">10 ग्राम: --</div>
</div>

<div class="card">
<h3>🥇 18 कैरेट सोना</h3>
<div class="price" id="g18">लोड हो रहा है</div>
<div class="small" id="g18ten">10 ग्राम: --</div>
</div>

<div class="card">
<h3>🥈 चांदी</h3>
<div class="price" id="silver">लोड हो रहा है</div>
<div class="small" id="silverten">10 ग्राम: --</div>
</div>
</div>

<div class="box">
<h2>📍 अपना शहर चुनें</h2>
<select id="city">
<option>Bhopal</option>
<option>Indore</option>
<option>Delhi</option>
<option>Mumbai</option>
<option>Jaipur</option>
<option>Lucknow</option>
<option>Patna</option>
<option>Kolkata</option>
<option>Chennai</option>
<option>Hyderabad</option>
<option>Ahmedabad</option>
<option>Bengaluru</option>
</select>
<p class="note">यह अंतरराष्ट्रीय Spot Rate का अनुमान है। स्थानीय दुकानों के भाव अलग हो सकते हैं।</p>
</div>

<div class="box">
<h2>📊 Gold Price Chart</h2>
<canvas id="chart"></canvas>
</div>

<div class="box">
<h2>🔔 Price Alert</h2>
<select id="metal">
<option value="gold">Gold 24K</option>
<option value="silver">Silver</option>
</select>
<input type="number" id="target" placeholder="लक्ष्य भाव प्रति ग्राम">
<button onclick="saveAlert()">अलर्ट लगाएं</button>
<p class="note" id="alertMessage"></p>
</div>

<div class="box">
<h2>👑 Premium Membership</h2>
<h3>₹100 / 2 महीने</h3>
<p>Premium में विशेष सुविधाएं उपलब्ध कराने की योजना है।</p>
<button onclick="alert('Payment Gateway अभी कनेक्ट नहीं है।')">Premium जल्द उपलब्ध</button>
</div>

<div class="box">
<h2>ℹ️ जानकारी</h2>
<p class="note">भाव अंतरराष्ट्रीय Spot Rate पर आधारित हैं। स्थानीय GST, टैक्स, मेकिंग चार्ज और ज्वेलरी दुकानों का प्रीमियम इसमें शामिल नहीं है।</p>
<p class="note">डेटा स्रोत: Gold API</p>
</div>

</div>

<footer>© 2026 Gold & Silver Tracker</footer>

<script>
const OUNCE=31.1034768;
let gold=0,silver=0;
let history=[];
let alertShown=false;

function rupee(n){
 return "₹"+n.toLocaleString("en-IN",{minimumFractionDigits:2,maximumFractionDigits:2});
}

async function fetchRate(symbol){
 const response=await fetch("https://api.gold-api.com/price/"+symbol+"/INR",{cache:"no-store"});
 if(!response.ok)throw new Error("API Error "+response.status);
 const data=await response.json();
 const price=Number(data.price);
 if(!Number.isFinite(price)||price<=0)throw new Error("Invalid price");
 return price/OUNCE;
}

async function update(){
 const status=document.getElementById("status");
 try{
  const result=await Promise.all([fetchRate("XAU"),fetchRate("XAG")]);
  gold=result[0];
  silver=result[1];

  document.getElementById("g24").textContent=rupee(gold);
  document.getElementById("g24ten").textContent="10 ग्राम: "+rupee(gold*10);

  document.getElementById("g22").textContent=rupee(gold*22/24);
  document.getElementById("g22ten").textContent="10 ग्राम: "+rupee(gold*22/24*10);

  document.getElementById("g18").textContent=rupee(gold*18/24);
  document.getElementById("g18ten").textContent="10 ग्राम: "+rupee(gold*18/24*10);

  document.getElementById("silver").textContent=rupee(silver);
  document.getElementById("silverten").textContent="10 ग्राम: "+rupee(silver*10);

  status.textContent="🟢 Live Spot Rate | अपडेट: "+new Date().toLocaleTimeString("hi-IN");

  history.push(gold);
  if(history.length>40)history.shift();
  drawChart();
  checkAlert();
 }catch(error){
  status.textContent="🔴 Live Rate नहीं मिला: "+error.message;
 }
}

function drawChart(){
 const c=document.getElementById("chart");
 const ctx=c.getContext("2d");
 const w=c.clientWidth,h=180;
 const dpr=window.devicePixelRatio||1;
 c.width=w*dpr;c.height=h*dpr;
 ctx.scale(dpr,dpr);
 ctx.clearRect(0,0,w,h);
 if(history.length<2){ctx.fillText("भाव का डेटा इकट्ठा हो रहा है...",10,25);return;}
 const min=Math.min(...history),max=Math.max(...history),range=max-min||1;
 ctx.beginPath();
 history.forEach((v,i)=>{
  const x=10+i*(w-20)/(history.length-1);
  const y=h-15-(v-min)/range*(h-35);
  if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);
 });
 ctx.strokeStyle="#e99513";ctx.lineWidth=2;ctx.stroke();
}

function saveAlert(){
 const target=Number(document.getElementById("target").value);
 if(!target||target<=0){alert("सही भाव डालें");return;}
 localStorage.setItem("goldSilverAlert",JSON.stringify({
  target:target,
  metal:document.getElementById("metal").value
 }));
 alertShown=false;
 document.getElementById("alertMessage").textContent="अलर्ट इस ब्राउज़र में सेव हो गया।";
}

function checkAlert(){
 const saved=localStorage.getItem("goldSilverAlert");
 if(!saved)return;
 const a=JSON.parse(saved);
 const current=a.metal==="gold"?gold:silver;
 if(current<=a.target&&!alertShown){
  alertShown=true;
  alert("Price Alert! आपका लक्ष्य भाव आ गया है।");
 }
}

update();
setInterval(update,300000);
window.addEventListener("resize",drawChart);
</script>

</body>
</html>
