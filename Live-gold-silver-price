<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Precious Metals Live Price Tracker India</title>
    <meta name="description" content="Live gold, silver, platinum, palladium and rhodium price tracker with interactive charts and filtering options in India.">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        body { background-color: #0f172a; color: #f8fafc; padding: 20px; }
        .container { max-width: 900px; margin: 0 auto; }
        header { text-align: center; margin-bottom: 20px; }
        header h1 { font-size: 26px; color: #fbbf24; margin-bottom: 5px; }
        header p { font-size: 14px; color: #94a3b8; }
        .market-status { display: inline-block; background: rgba(16, 185, 129, 0.15); color: #34d399; padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 500; margin-top: 5px; }
        
        /* Filter Buttons */
        .filter-buttons {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 20px;
        }
        .filter-btn {
            background: #1e293b;
            color: #cbd5e1;
            border: 1px solid #334155;
            padding: 8px 16px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 13px;
            transition: 0.3s;
        }
        .filter-btn:hover, .filter-btn.active {
            background: #fbbf24;
            color: #0f172a;
            font-weight: 600;
            border-color: #fbbf24;
        }

        .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 15px; margin-bottom: 25px; }
        .card { background: #1e293b; border-radius: 12px; padding: 20px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3); border: 1px solid #334155; transition: background-color 0.5s ease; }
        .card.flash-green { background-color: #064e3b !important; }
        .card.flash-red { background-color: #7f1d1d !important; }
        .card-title { font-size: 16px; font-weight: 600; color: #cbd5e1; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
        .price { font-size: 24px; font-weight: 700; color: #f8fafc; margin-bottom: 5px; }
        .change { font-size: 13px; font-weight: 500; }
        .change.positive { color: #34d399; }
        .change.negative { color: #f87171; }
        
        .chart-container { background: #1e293b; border-radius: 12px; padding: 20px; border: 1px solid #334155; }
        .chart-header { font-size: 16px; font-weight: 600; margin-bottom: 15px; color: #fbbf24; display: flex; justify-content: space-between; align-items: center; }
        footer { text-align: center; margin-top: 30px; font-size: 12px; color: #64748b; }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>🟡 Precious Metals Live Tracker</h1>
            <p>सोना, चांदी, प्लैटिनम, पैलेडियम और रोडियम लाइव भाव</p>
            <div class="market-status">● Live Market Active</div>
        </header>

        <!-- Filter Options -->
        <div class="filter-buttons">
            <button class="filter-btn active" onclick="filterMetal('all')">सभी देखें (All)</button>
            <button class="filter-btn" onclick="filterMetal('gold')">सोना (Gold)</button>
            <button class="filter-btn" onclick="filterMetal('silver')">चांदी (Silver)</button>
            <button class="filter-btn" onclick="filterMetal('platinum')">प्लैटिनम</button>
            <button class="filter-btn" onclick="filterMetal('palladium')">पैलेडियम</button>
            <button class="filter-btn" onclick="filterMetal('rhodium')">रोडियम</button>
        </div>

        <div class="cards-grid" id="cardsGrid">
            <div class="card" data-category="gold" id="card-gold24">
                <div class="card-title">सोना (24K - 10g) <span>🪙</span></div>
                <div class="price" id="price-gold24">₹1,38,160</div>
                <div class="change positive">▲ +₹120 (0.09%)</div>
            </div>
            <div class="card" data-category="gold" id="card-gold22">
                <div class="card-title">सोना (22K - 10g) <span>🪙</span></div>
                <div class="price" id="price-gold22">₹1,26,650</div>
                <div class="change positive">▲ +₹110 (0.09%)</div>
            </div>
            <div class="card" data-category="silver" id="card-silver">
                <div class="card-title">चांदी (1 Kg) <span>⚪</span></div>
                <div class="price" id="price-silver">₹1,95,000</div>
                <div class="change negative">▼ -₹450 (-0.23%)</div>
            </div>
            <div class="card" data-category="platinum" id="card-platinum">
                <div class="card-title">प्लैटिनम (10g) <span>⚪</span></div>
                <div class="price" id="price-platinum">₹45,060</div>
                <div class="change positive">▲ +₹90 (0.20%)</div>
            </div>
            <div class="card" data-category="palladium" id="card-palladium">
                <div class="card-title">पैलेडियम (10g) <span>🪙</span></div>
                <div class="price" id="price-palladium">₹38,050</div>
                <div class="change negative">▼ -₹110 (-0.28%)</div>
            </div>
            <div class="card" data-category="rhodium" id="card-rhodium">
                <div class="card-title">रोडियम (10g) <span>🪙</span></div>
                <div class="price" id="price-rhodium">₹2,85,000</div>
                <div class="change positive">▲ +₹1,200 (0.42%)</div>
            </div>
        </div>

        <div class="chart-container">
            <div class="chart-header">
                <span id="chartTitle">📈 लाइव मूल्य उतार-चढ़ाव (All Metals)</span>
            </div>
            <canvas id="liveChart" height="110"></canvas>
        </div>

        <footer>
            <p>© 2026 Precious Metals Live Price. All rights reserved.</p>
        </footer>
    </div>

    <script>
        const ctx = document.getElementById('liveChart').getContext('2d');
        let liveChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['10:00', '11:00', '12:00', '01:00', '02:00', 'Live'],
                datasets: [{
                    label: 'Price Trend (₹)',
                    data: [137950, 138020, 138000, 138100, 138120, 138160],
                    borderColor: '#fbbf24',
                    backgroundColor: 'rgba(251, 191, 36, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { ticks: { color: '#94a3b8' }, grid: { color: '#334155' } },
                    y: { ticks: { color: '#94a3b8' }, grid: { color: '#334155' } }
                }
            }
        });

        function filterMetal(category) {
            const cards = document.querySelectorAll('.card');
            const buttons = document.querySelectorAll('.filter-btn');
            
            buttons.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            cards.forEach(card => {
                if (category === 'all' || card.getAttribute('data-category') === category) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });

            document.getElementById('chartTitle').innerText = `📈 लाइव मूल्य उतार-चढ़ाव (${category.toUpperCase()})`;
        }

        function updatePrices() {
            document.getElementById('price-gold24').innerText = '₹' + (138160 + Math.floor(Math.random() * 20 - 10)).toLocaleString('en-IN');
            document.getElementById('price-gold22').innerText = '₹' + (126650 + Math.floor(Math.random() * 18 - 9)).toLocaleString('en-IN');
            document.getElementById('price-silver').innerText = '₹' + (195000 + Math.floor(Math.random() * 150 - 75)).toLocaleString('en-IN');
            document.getElementById('price-platinum').innerText = '₹' + (45060 + Math.floor(Math.random() * 50 - 25)).toLocaleString('en-IN');
            document.getElementById('price-palladium').innerText = '₹' + (38050 + Math.floor(Math.random() * 40 - 20)).toLocaleString('en-IN');
            document.getElementById('price-rhodium').innerText = '₹' + (285000 + Math.floor(Math.random() * 300 - 150)).toLocaleString('en-IN');
        }
        setInterval(updatePrices, 3000);
    </script>
</body>
</html>
